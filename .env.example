# --- Required ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contractdb
DB_USER=contractuser
DB_PASS=contractpass

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

# JWT secret: generate a strong random string (min 64 chars)
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS_LONG

# --- Optional (defaults in application.yml) ---
SERVER_PORT=8080
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=50
MAX_PAGES=500
MAX_PARAGRAPHS=10000
PARSE_COVERAGE_THRESHOLD=70

COUNSEL_TOKEN_TTL_DAYS=7
COUNSEL_RATE_LIMIT=20
COUNSEL_SEND_RATE_LIMIT=5

SENDGRID_API_KEY=
FROM_EMAIL=noreply@contractcompiler.com
FROM_NAME=Contract Compiler

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

LOG_LEVEL=INFO

BENCHMARK_MIN_RECALL=0.90
BENCHMARK_MIN_PRECISION=0.85

LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
